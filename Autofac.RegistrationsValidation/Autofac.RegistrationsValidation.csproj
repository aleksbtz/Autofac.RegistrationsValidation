<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Aleksbtz.Autofac.RegistrationsValidation</RootNamespace>
        <AssemblyName>Aleksbtz.Autofac.RegistrationsValidation</AssemblyName>
        <Title>Aleksbtz.Autofac.RegistrationsValidation</Title>
        <Authors>Aleksandr Butuzov</Authors>
        <Description>An Autofac extensions library which allows to validate the container on-build for captive dependencies and missing registration.</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageVersion>0.2.0</PackageVersion>
        <PackageProjectUrl>https://github.com/aleksbtz/Autofac.RegistrationsValidation</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/aleksbtz/Autofac.RegistrationsValidation/blob/master/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/aleksbtz/Autofac.RegistrationsValidation</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Autofac" Version="5.0.0" />
    </ItemGroup>

</Project>
